# Database configuration (SQLite local or PostgreSQL for production)
DATABASE_URL="file:./dev.db"

# Public site domain
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# WhatsApp Business / Support phone number (E.164 format)
NEXT_PUBLIC_WHATSAPP_NUMBER="+212600000000"

# Admin portal credentials
ADMIN_EMAIL="admin@workflows.com"
ADMIN_PASSWORD="admin123456"
ADMIN_SECRET="your_secure_admin_secret_key_here"

# Required in production. Use a long, random value to sign client/admin sessions.
SESSION_SECRET="replace_with_a_long_random_session_secret"
