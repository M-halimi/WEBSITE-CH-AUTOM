generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                String                   @id @default(cuid())
  email             String                   @unique
  name              String?
  passwordHash      String
  role              String                   @default("CLIENT") // ADMIN, CLIENT
  phone             String?
  company           String?
  country           String?                  @default("Morocco")
  businessType      String?                  // E-commerce, Agency, Local Business, SaaS, Services, Other
  emailVerified     Boolean                  @default(false)
  verificationToken String?
  resetToken        String?
  resetTokenExpiry  DateTime?
  
  // Relations
  clientProfile     ClientProfile?
  subscriptions     Subscription[]
  workflowRequests  ClientWorkflowRequest[]
  sentMessages      ClientWorkflowMessage[]
  activities        ClientWorkflowActivity[]

  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
}

model ClientProfile {
  id                     String   @id @default(cuid())
  userId                 String   @unique
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName           String?
  businessType           String?
  industry               String?
  customerContactMethods String?  // JSON string or comma-separated: WhatsApp, Instagram, Website, etc.
  website                String?
  onboardingCompleted    Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model Plan {
  id             String         @id @default(cuid())
  name           String         @unique // STARTER, BUSINESS, PRO
  slug           String         @unique
  tagline        String?
  price          Float          @default(49)
  currency       String         @default("USD") // USD, MAD, EUR
  billingPeriod  String         @default("MONTHLY") // MONTHLY, YEARLY
  features       String         // JSON array string of features
  workflowLimit  Int            @default(1) // 1 for Starter, 5 for Business, 999 for Pro (unlimited)
  supportLevel   String         @default("Basic Consultation")
  isPopular      Boolean        @default(false)
  active         Boolean        @default(true)
  subscriptions  Subscription[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model Subscription {
  id                     String                  @id @default(cuid())
  userId                 String
  user                   User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId                 String
  plan                   Plan                    @relation(fields: [planId], references: [id], onDelete: Restrict)
  status                 String                  @default("ACTIVE") // ACTIVE, PAST_DUE, CANCELED, TRIALING
  billingPeriod          String                  @default("MONTHLY") // MONTHLY, YEARLY
  currentPeriodStart     DateTime                @default(now())
  currentPeriodEnd       DateTime
  cancelAtPeriodEnd      Boolean                 @default(false)
  provider               String                  @default("MANUAL") // MANUAL, STRIPE, PAYPAL, CMI
  providerSubscriptionId String?
  usedWorkflowsCount     Int                     @default(0)
  workflowRequests       ClientWorkflowRequest[]
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
}

model ClientWorkflowRequest {
  id                    String                       @id @default(cuid())
  userId                String
  user                  User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptionId        String?
  subscription          Subscription?                @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  
  // Step 1: Business Overview
  title                 String                       // e.g. "WhatsApp Order Qualifier & CRM Sync"
  businessName          String?
  businessType          String?
  industry              String?
  businessDescription   String?                      // "What your business does..."
  targetCustomers       String?                      // "Who are your customers..."
  customerChannels      String?                      // "WhatsApp, Instagram, Website..."
  
  // Step 2: Problem Definition
  problemDescription    String?                      // "What is currently difficult, slow, repetitive..."
  frequency             String?                      // "Several times a day", "Daily", etc.
  estimatedTime         String?                      // "2 hours daily"
  costOfFailure         String?                      // "What happens if done wrong..."
  priority              String                       @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  
  // Step 4 & 7: Desired Result & Goals
  desiredAutomationDesc String?                      // "What should happen automatically..."
  expectedResult        String?                      // "What should the final result look like..."
  successCriteria       String?                      // "What would make you say: Yes, this works perfectly..."
  expectedDeadline      String?
  budgetRange           String?
  additionalNotes       String?
  
  // Workflow Lifecycle Status
  status                String                       @default("PENDING_REVIEW") 
  // DRAFT, PENDING_REVIEW, REVIEWING, NEEDS_INFORMATION, APPROVED, IN_PROGRESS, TESTING, COMPLETED, REJECTED, CANCELLED
  progress              Int                          @default(10) // 0 to 100
  
  // Team / Developer Assignment & Estimates
  assignedToId          String?
  assignedToName        String?
  estimatedComplexity   String?                      // Low, Medium, High, Multi-Agent
  estimatedPrice        String?
  estimatedDeliveryTime String?                      // e.g. "48 hours", "3 days"
  internalNotes         String?                      // Private team notes
  
  // Relations
  steps                 ClientWorkflowStep[]
  integrations          ClientWorkflowIntegration[]
  files                 ClientWorkflowFile[]
  messages              ClientWorkflowMessage[]
  activities            ClientWorkflowActivity[]
  
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt
}

model ClientWorkflowStep {
  id                String                @id @default(cuid())
  requestId         String
  request           ClientWorkflowRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  phase             String                @default("CURRENT") // CURRENT, DESIRED
  order             Int                   @default(1)
  title             String                // e.g. "Customer sends WhatsApp message"
  description       String?
  tool              String?               // e.g. "WhatsApp", "Excel", "Shopify"
  responsiblePerson String?               // e.g. "Support Rep", "Me", "Automation Engine"
  expectedResult    String?
  createdAt         DateTime              @default(now())
}

model ClientWorkflowIntegration {
  id           String                @id @default(cuid())
  requestId    String
  request      ClientWorkflowRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  toolName     String                // e.g. "WhatsApp Business", "Google Sheets", "Shopify"
  toolCategory String?               // Messaging, E-commerce, Spreadsheet, CRM, Payment
  purpose      String?               // "What do you currently use this tool for?"
  websiteUrl   String?
  accountInfo  String?               // Non-sensitive info / account tier
  hasApi       Boolean               @default(true)
  createdAt    DateTime              @default(now())
}

model ClientWorkflowFile {
  id         String                @id @default(cuid())
  requestId  String
  request    ClientWorkflowRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  fileName   String
  fileUrl    String                // Base64 data URL or uploaded file path
  fileType   String                // image/png, application/pdf, text/csv, etc.
  fileSize   Int                   @default(0) // bytes
  uploadedAt DateTime              @default(now())
}

model ClientWorkflowMessage {
  id         String                @id @default(cuid())
  requestId  String
  request    ClientWorkflowRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  senderId   String?
  senderRole String                @default("CLIENT") // CLIENT, TEAM
  senderName String
  message    String
  isInternal Boolean               @default(false) // If true, only visible to team/admin
  createdAt  DateTime              @default(now())
}

model ClientWorkflowActivity {
  id          String                @id @default(cuid())
  requestId   String
  request     ClientWorkflowRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actorId     String?
  actorName   String?
  actorRole   String                @default("SYSTEM") // CLIENT, TEAM, SYSTEM
  type        String                @default("STATUS_CHANGE") 
  // CREATED, STATUS_CHANGE, PROGRESS_UPDATE, ASSIGNED, MESSAGE_SENT, ESTIMATE_SET, FILE_UPLOADED
  description String
  createdAt   DateTime              @default(now())
}

// ----------------------------------------------------
// Existing Marketplace & Catalog Models
// ----------------------------------------------------

model Category {
  id          String     @id @default(cuid())
  name        String     @unique
  slug        String     @unique
  description String?
  icon        String?    // Lucide icon name or emoji
  order       Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  workflows   Workflow[]
}

model Platform {
  id          String               @id @default(cuid())
  name        String               @unique
  slug        String               @unique
  icon        String?              // Icon name or SVG URL
  color       String?              // Hex or badge class
  workflows   WorkflowOnPlatform[]
  createdAt   DateTime             @default(now())
}

model Tag {
  id          String          @id @default(cuid())
  name        String          @unique
  slug        String          @unique
  workflows   WorkflowOnTag[]
  createdAt   DateTime        @default(now())
}

model Workflow {
  id                  String               @id @default(cuid())
  title               String
  slug                String               @unique
  summary             String
  description         String
  difficulty          String               @default("BEGINNER") // BEGINNER, INTERMEDIATE, ADVANCED
  estimatedTime       String               @default("15 mins")
  stepsCount          Int                  @default(0)
  status              String               @default("DRAFT") // DRAFT, PUBLISHED, ARCHIVED
  views               Int                  @default(0)
  featured            Boolean              @default(false)
  price               String?              @default("Free / Included")
  imageUrl            String?              // Thumbnail or banner preview image URL
  demoUrl             String?
  n8nJson             String?              // Raw JSON export if imported
  
  // Rich descriptions
  triggersDescription String?
  outcomesDescription String?
  requirements        String?              // JSON or markdown of credentials/tools needed
  
  // Relations
  categoryId          String?
  category            Category?            @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  platforms           WorkflowOnPlatform[]
  tags                WorkflowOnTag[]
  steps               WorkflowStep[]
  requests            LeadRequest[]

  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

model WorkflowStep {
  id          String   @id @default(cuid())
  workflowId  String
  workflow    Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  order       Int      @default(0)
  name        String
  type        String   @default("ACTION") // TRIGGER, ACTION, CONDITION, TRANSFORM, NOTIFICATION
  description String?
  icon        String?  // Icon name (e.g., 'zap', 'database', 'mail', 'bot')
  appName     String?  // e.g. "WhatsApp", "Google Sheets", "OpenAI"
  configJson  String?  // Optional extra metadata
  createdAt   DateTime @default(now())
}

model WorkflowOnPlatform {
  workflowId String
  platformId String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  platform   Platform @relation(fields: [platformId], references: [id], onDelete: Cascade)

  @@id([workflowId, platformId])
}

model WorkflowOnTag {
  workflowId String
  tagId      String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([workflowId, tagId])
}

model LeadRequest {
  id          String    @id @default(cuid())
  name        String
  email       String
  whatsapp    String?
  company     String?
  message     String?
  status      String    @default("NEW") // NEW, CONTACTED, IN_PROGRESS, COMPLETED, CANCELLED
  workflowId  String?
  workflow    Workflow? @relation(fields: [workflowId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model SiteSetting {
  id               String   @id @default("default")
  siteName         String   @default("AutoFlows Hub")
  siteDescription  String   @default("The Commerce Automation Platform")
  whatsappNumber   String   @default("+212600000000")
  defaultCurrency  String   @default("MAD")
  heroBadge        String   @default("Workflow Support & Growth")
  heroTitle        String   @default("Automate Your Support Workflows")
  heroSubtitle     String   @default("Streamline repetitive tasks and scale customer support with ease using smart, flexible, and fast workflows.")
  ctaBadge         String   @default("Turnkey Enterprise Engineering")
  ctaTitle         String   @default("Start automating your commerce infrastructure today.")
  ctaDescription   String   @default("Connect with our certified engineers to build custom n8n, Meta Ads & WhatsApp pipelines in 48 hours.")
  ctaButtonText    String   @default("Request Custom Blueprint")
  ctaSecondaryText String   @default("WhatsApp Direct")
  footerCopyright  String   @default("© 2026 AutoFlows Hub Inc. All rights reserved.")
  updatedAt        DateTime @updatedAt
}
